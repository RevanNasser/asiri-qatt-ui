{
  "name": "qatt-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Qatt UI (قَطّ) — an Arabic-first, RTL shadcn/ui registry inspired by Al-Qatt Al-Asiri.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm registry:build && next dev --webpack",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "registry:gen": "tsx scripts/registry-gen.ts",
    "registry:build": "pnpm registry:gen && shadcn build .registry/registry.json --output public/r",
    "registry:validate": "shadcn registry validate ./registry.json && pnpm registry:gen && shadcn registry validate .registry/registry.json && tsx scripts/registry-check.ts",
    "registry:serve": "node scripts/serve-registry.mjs public 4000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:install": "tsx scripts/install-flow.ts",
    "motifs:gen": "tsx scripts/motifs-gen.ts && prettier --write registry/qatt/lib/qatt-motifs.ts",
    "copy:gen": "tsx scripts/copy-gen.ts && prettier --write lib/copy.ar.generated.ts lib/copy.en.generated.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fumadocs-core": "16.19.4",
    "fumadocs-mdx": "15.6.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.4",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "vitest-axe": "^0.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "esbuild"
    ]
  }
}
